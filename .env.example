# ==============================================================================
# AEON Frontend — Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the repository root for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTE:
# All variables prefixed with `VITE_` are bundled and exposed to the browser.
# NEVER place sensitive secrets here (such as database credentials, PayPal
# client secrets, backend JWT SECRET_KEY, or private agent API keys).
# ==============================================================================

# ------------------------------------------------------------------------------
# API Mode
# ------------------------------------------------------------------------------
# Controls how the frontend handles data and API requests:
#   - "backend": (Default) Connects to the live AEON FastAPI backend. Requires the
#                backend server to be running and reachable.
#   - "demo":    Operates completely client-side in standalone demonstration mode
#                using realistic simulated responses and localStorage. No backend
#                or database needed.
VITE_API_MODE=backend

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
# The base URL where the AEON FastAPI backend is hosted.
#   - Local development: http://127.0.0.1:8000
#   - Production:        https://your-aeon-backend.onrender.com
# Defaults to http://127.0.0.1:8000 if left blank or omitted.
VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Vite Dev Server Proxy Target
# ------------------------------------------------------------------------------
# Used by Vite's development server (vite.config.ts) during local development
# to proxy /api, /health, /live, and /ready endpoints to the backend.
# Do not put PayPal secrets or backend credentials in this file.
# Defaults to http://127.0.0.1:8000 if not specified.
AEON_API_PROXY_TARGET=http://127.0.0.1:8000
